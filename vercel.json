{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/validate-app-update.mjs",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/app-update/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
